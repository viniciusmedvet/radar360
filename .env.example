# Coleta dos canais de referência (Google Cloud Console > YouTube Data API v3 > Chave de API)
YOUTUBE_API_KEY=

# Geração de roteiros (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# Publicação no SEU canal (OAuth "App para computador"; refresh token via npm run token-youtube)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# true quando a narração ou imagens forem geradas por IA de forma realista (exigência de rotulagem do YouTube)
CONTEUDO_SINTETICO=true

# Opcionais
# DATA_PUBLICACAO=2026-09-29
# DESLOCAMENTO_DIAS=0
# JANELA_HORAS=48
